<h1>Pages#admin</h1>
<p>Find me in app/views/pages/admin.html.erb</p>
<% if @users.count > 0 %>
  <table class="table table-hover w-75 mx-auto">
    <thead class="table-dark">
      <tr>
        <th>Email</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td class="col-6"><%= user.email %></td>
          <td class="col-3">
            <span class="<%= user.access_locked? ? 'text-danger' : 'text-success' %>">
              <%= user.access_locked? ? 'Banned' : 'Active' %>
            </span>
          </td>
          <td class="col-3">
            <% if user.access_locked? %>
              <%= button_to 'Unban', pages_unban_user_path(user), class: "btn btn-success", method: :post %>
            <% else %>
              <%= button_to 'Ban', pages_ban_user_path(user), class: "btn btn-danger", method: :post %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <br>
  <p class="fw-bold text-danger text-center"> No user registered! </p>
  <br>
<% end %>
