<h1>Pages#admin</h1>
<p>Find me in app/views/pages/admin.html.erb</p>
  <table class="table table-hover">
    <thead class="table-dark">
      <tr>
        <th>Email</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.email %></td>
          <td>
            <span class="<%= user.access_locked? ? 'text-danger' : 'text-success' %>">
              <%= user.access_locked? ? 'Banned' : 'Active' %>
            </span>
          </td>
          <td>
            <% if user.access_locked? %>
              <%= button_to 'Unban', pages_unban_user_path(user), class: "btn btn-success", method: :post %>
            <% else %>
              <%= button_to 'Ban', pages_ban_user_path(user), class: "btn btn-danger", method: :post %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
